    region udas (
        name: UDAS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.uda_id, u.uda_desc, uv.uda_value, uv.uda_value_desc
                from worksheet_uda wu, uda@dasprd u, uda_values@dasprd uv
                where worksheet_id = :P3_worksheet_id
                and wu.uda_id = u.uda_id(+)
                and wu.uda_id = uv.uda_id(+)
                and wu.uda_value = uv.uda_value(+);
                
                ```
        }
        layout {
            sequence: 40
            parentRegion: @associated-items
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 43030574410238420
        }


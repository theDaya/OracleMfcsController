page 3 (
    name: Create Style
    title: Create Style
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration: var htmldb_delete_message='"DELETE_CONFIRM_MSG"';
        executeWhenPageLoads:
            ```javascript-browser
                document.getElementById('P3_MARGIN').setAttribute('readonly', true)
                $('#P3_MARGIN').css('color','red');
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region associated-items (
        name: Associated Items
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_WORKSHEET_ID
        }
        settings {
            includeShowAll: false
            rememberSelection: bySession
        }
    )

    region create-style (
        name: Create Style
        type: form
        source {
            location: localDatabase
            tableName: WORKSHEET_STYLE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region skus (
        name: SKUS
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select * from worksheet_sku where worksheet_id = :P3_WORKSHEET_ID
        }
        layout {
            sequence: 30
            parentRegion: @associated-items
            slot: subRegions
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        link {
            linkColumn: customTarget
            target: {
                page: 6
                items: {
                    P6_WORKSHEET_SKU_ID: #WORKSHEET_SKU_ID#
                }
                action: resetPagination
            }
            linkIcon: <img src="#IMAGE_PREFIX#app_ui/img/icons/apex-edit-pencil.png" class="apex-edit-pencil" alt="">
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        advanced {
            savedReportMappingIdentifier: 37687164163240041
        }

        column RMS_SKU (
            type: plainText
            heading {
                heading: Rms Sku
                alignment: center
            }
            layout {
                sequence: 30
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: C
            }
        )

        column SKU_QTY (

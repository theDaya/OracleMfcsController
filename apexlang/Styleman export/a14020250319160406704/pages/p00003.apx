    dynamicAction calc-margin (
        name: Calc Margin
        execution {
            sequence: 40
        }
        when {
            event: keyup
            selectionType: items
            items: [
                P3_RSP
                P3_COST_PRICE
            ]
        }

        action native-javascript-code (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript-browser
                     $("#P3_MARGIN").val("");
                    try{
                        var l_rsp = Number($("#P3_RSP").val());
                        var l_cost= Number($("#P3_COST_PRICE").val());
                        var l_vat = Number(1.15);
                        var l_rsp_exvat = l_rsp/l_vat;
                        
                        if(l_rsp>0 && l_cost > 0){
                       // var l_margin = "Margin : "+Math.round(((l_rsp/l_cost)-1)*100)+" %";
                         //var l_margin = "Margin : "+Math.round(((l_rsp_exvat-l_cost)/l_rsp_exvat)*100)+" %";
                        var l_margin = "Margin : "+parseFloat(((l_rsp_exvat-l_cost)/l_rsp_exvat)*100).toFixed(2)+" %";
                        //$("#P3_MARGIN").value(number($("#P3_COST_PRICE").val())+3);
                      //  alert(Number($("#P3_COST_PRICE").val())+3);
                        $("#P3_MARGIN").val(l_margin);
                        }
                        document.getElementById('P3_MARGIN').setAttribute('readonly', true)
                        
                    }
                    catch (err) {
                    null;
                    }
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )


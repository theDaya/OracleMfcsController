        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: functionBody
            plsqlFunctionBody:
                ```plsql
                declare
                l_count_skus number;
                l_count_udas number;
                
                begin
                
                if(:p3_worksheet_id is null) then
                return false;
                end if;
                
                if(:p3_worksheet_status = 'A') then
                return false;
                end if;
                
                select count(1) into l_count_skus
                from worksheet_sku where worksheet_id = :P3_WORKSHEET_ID;
                
                select count(1) into l_count_udas
                from worksheet_uda where worksheet_id = :P3_WORKSHEET_ID;
                
                if(l_count_skus > 0 and l_count_udas > 0  ) then
                
                return true;
                
                end if;
                
                
                end;
                ```
        }
    )


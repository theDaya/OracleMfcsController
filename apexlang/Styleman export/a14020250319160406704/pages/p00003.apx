    process set-default-udas (
        name: Set Default UDAs
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                cursor c_recs is 
                SELECT uda_id, uda_value FROM     UDA_ITEM_DEFAULTS@dasprd WHERE dept = :P3_DEPT AND class IS NULL 
                AND required_ind = 'Y' 
                UNION
                SELECT uda_id, uda_value FROM      UDA_ITEM_DEFAULTS@dasprd WHERE dept = :P3_DEPT AND class = :P3_CLASS AND subclass IS null 
                AND required_ind = 'Y' 
                UNION
                SELECT uda_id, uda_value FROM      UDA_ITEM_DEFAULTS@dasprd WHERE dept = :P3_DEPT AND class = :P3_CLASS AND subclass =:P3_SUBCLASS
                AND required_ind = 'Y' 
                union
                select uda_id, uda_value from styleman_uda_defaults where dept = :P3_DEPT AND class = :P3_CLASS ;
                
                begin
                
                for r_recs in c_recs loop
                 insert into worksheet_uda (WORKSHEET_ID, UDA_ID, UDA_VALUE)  values (:P3_WORKSHEET_ID, r_recs.uda_id, r_recs.uda_value);
                
                end loop;
                
                
                end;
                
                ```
        }
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 23743396393999719
        }
        serverSideCondition {
            whenButtonPressed: @create
        }
    )

)


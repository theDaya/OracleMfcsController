                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            width: 8.5
            height: 11
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 430160 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn RMS_SKU (

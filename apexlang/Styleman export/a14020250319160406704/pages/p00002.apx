    process copy-style (
        name: Copy style
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                l_worksheet_id number;
                
                
                cursor c_style_rec is 
                
                SELECT i.item, 
                       diff_1 colour_group,
                       diff_2 size_group,
                       dept,
                       class,
                       subclass,
                       short_desc, 
                       isc.supplier, 
                       iss.vpn, 
                       isc.origin_country_id origin_country,
                       isc.unit_cost,
                       i.original_retail, 
                        ismc.manu_country_id manuf_country,
                        isc.supp_pack_size,
                        isc.inner_pack_size,
                        (SELECT Max(season_id)
                            FROM  nb_v_item_seasons@dasprd ise
                            WHERE ise.item = i.item) season_id,
                        (SELECT Max(phase_id)
                            FROM  nb_v_item_seasons@dasprd ise
                            WHERE ise.item = i.item
                            AND season_id IN (        (SELECT Max(season_id)
                            FROM  nb_v_item_seasons@dasprd ise
                            WHERE ise.item = i.item))) phase_id  ,
                        (SELECT Max(diff_1)
                            FROM  nb_v_item_master@dasprd im1
                            WHERE im1.item_parent = i.item) colour_id
                FROM item_master@dasprd i , item_supplier@dasprd iss, item_supp_country@dasprd isc, item_supp_manu_country@dasprd ismc
                WHERE i.item = To_Char(:P2_STYLE)
                AND isc.item = iss.item     
                AND iss.item = i.item
                AND iss.primary_supp_ind = 'Y' 
                AND isc.primary_supp_ind = 'Y'
                AND isc.primary_country_ind = 'Y'
                AND ismc.primary_manu_ctry_ind = 'Y'
                AND ismc.item = isc.item
                AND ismc.supplier = isc.supplier;
                
                
                CURSOR c_sku_recs IS 
                SELECT item, diff_2 FROM item_master@dasprd WHERE item_parent =   To_Char(:P2_STYLE);
                
                
                CURSOR c_uda_recs IS 
                SELECT uda_id, uda_value FROM uda_item_lov@dasprd WHERE item = To_Char(:P2_STYLE);
                
                begin
                for r_recs in c_style_rec loop
                
                INSERT INTO rms_ext.worksheet_style (
                     worksheet_status, 
                     dept, 
                     class,
                     subclass, 
                     style_desc, 
                     style_short_desc, 
                     supplier,
                     origin_country, 
                     cost_price, 
                     pack_size_case, 
                     pack_size_inner,
                     manufacture_ctry,
                     rsp, 
                     season, 
                     phase, 
                     delivery_loc, 
                     vpn,
                     colour_group, 
                     colour_id, 
                     size_group)
                  VALUES (
                     'W',
                     r_recs.dept,
                     r_recs.class,
                     r_recs.subclass,
                     r_recs.short_desc,
                     r_recs.short_desc,
                     r_recs.supplier,
                     r_recs.origin_country,
                     r_recs.unit_cost,
                     r_recs.inner_pack_size, --should be the same as inner_pack_size
                     r_recs.inner_pack_size,
                    r_recs.manuf_country,
                     r_recs.original_retail,
                     r_recs.season_id,
                     r_recs.phase_id,
                     NULL, --delivery_loc,
                     r_recs.vpn,
                     r_recs.colour_group,
                     r_recs.colour_id,
                     r_recs.size_group) returning worksheet_id INTO l_worksheet_id;
                
                  Dbms_Output.put_line('Created worksheet_id '||l_worksheet_id);
                
                  FOR r_sku_recs IN c_sku_recs LOOP
                   INSERT INTO rms_ext.worksheet_sku (worksheet_id, sku_size) VALUES (l_worksheet_id,r_sku_recs.diff_2 ); 
                  END LOOP;
                
                  FOR r_uda_recs IN c_uda_recs LOOP
                   INSERT INTO rms_ext.worksheet_uda (worksheet_id, uda_id, uda_value) VALUES (l_worksheet_id,r_uda_recs.uda_id, r_uda_recs.uda_value ); 
                  END LOOP;
                
                
                
                end loop;
                :P2_NEW_WORKSHEET_ID:=l_worksheet_id;
                
                end;
                
                
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Style Copied!
        }
        advanced {
            executionMappingIdentifier: 23746167045999747
        }
        serverSideCondition {
            whenButtonPressed: @copy
        }
    )

    branch (
        name: Go to worksheet style detail
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 3
                items: {
                    P3_WORKSHEET_ID: &P2_NEW_WORKSHEET_ID.
                }
                action: resetPagination
            }
        }
        serverSideCondition {
            whenButtonPressed: @copy
        }
    )

)


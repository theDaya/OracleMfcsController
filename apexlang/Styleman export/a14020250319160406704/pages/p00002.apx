    region details (
        name: Details
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                SELECT i.item, diff_1 colour_group, diff_2 size_group, dept, class, subclass, short_desc, 
                       isc.supplier, iss.vpn, isc.origin_country_id origin_country, isc.unit_cost,i.original_retail, 
                        ismc.manu_country_id manuf_country,
                        isc.supp_pack_size,
                        isc.inner_pack_size,
                        (SELECT Max(season_id)
                            FROM  nb_v_item_seasons@dasprd ise
                            WHERE ise.item = i.item) season_id,
                        (SELECT Max(phase_id)
                            FROM  nb_v_item_seasons@dasprd ise
                            WHERE ise.item = i.item
                            AND season_id IN (        (SELECT Max(season_id)
                            FROM  nb_v_item_seasons@dasprd ise
                            WHERE ise.item = i.item))) phase_id  ,
                        (SELECT Max(diff_1)
                            FROM  nb_v_item_master@dasprd im1
                            WHERE im1.item_parent = i.item) colour_id
                FROM item_master@dasprd i , item_supplier@dasprd iss, item_supp_country@dasprd isc, item_supp_manu_country@dasprd ismc
                WHERE i.item = to_char(:P2_STYLE)
                AND isc.item = iss.item     
                AND iss.item = i.item
                AND iss.primary_supp_ind = 'Y' 
                AND isc.primary_supp_ind = 'Y'
                AND isc.primary_country_ind = 'Y'
                AND ismc.primary_manu_ctry_ind = 'Y'
                AND ismc.item = isc.item
                AND ismc.supplier = isc.supplier;
                
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            regionDisplaySelector: true
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        searchBar {
            includeSearchBar: false
        }
        detailView {
            show: true
        }
        advanced {
            savedReportMappingIdentifier: 23743907267999725
        }


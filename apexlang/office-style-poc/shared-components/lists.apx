list desktop-navigation-bar (
    name: Desktop Navigation Bar

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry separator (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
    )

)

list desktop-navigation-menu (
    name: Desktop Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry capture (
        label: Capture
        icon {
            imageIconCssClasses: fa-plus-square-o
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: 2
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry drafts (
        label: Drafts and Approvals
        icon {
            imageIconCssClasses: fa-check-square-o
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: 5
        }
        link {
            target: {
                page: 5
            }
        }
    )

    entry amend-order (
        label: Amend Order
        icon {
            imageIconCssClasses: fa-pencil-square-o
        }
        layout {
            sequence: 35
        }
        isCurrent {
            type: pages
            pages: 9
        }
        link {
            target: {
                page: 9
            }
        }
    )

    entry execution (
        label: Execution
        icon {
            imageIconCssClasses: fa-list-ol
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: 8
        }
        link {
            target: {
                page: 8
            }
        }
    )

    entry style-viewer (
        label: Style Viewer
        icon {
            imageIconCssClasses: fa-search
        }
        layout {
            sequence: 50
        }
        isCurrent {
            type: pages
            pages: 4
        }
        link {
            target: {
                page: 4
            }
        }
    )

    entry reference-data (
        label: Reference Data
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 60
        }
        isCurrent {
            type: pages
            pages: 3
        }
        link {
            target: {
                page: 3
            }
        }
    )

)

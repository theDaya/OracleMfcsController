customAttribute attribute_01 (
    apexlangName: noResultsFoundMessage
    attribute: 1
    name: No Results Found Message
    scope: app
    appearance {
        sequence: 10
    }
    builder {
        translatable: true
    }
    help {
        helpText: The default message is "No results found".
    }
)

customAttribute attribute_01 (
    apexlangName: selectListType
    attribute: 1
    name: Select List Type
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 10
    }
    default {
        value: SINGLE
    }
    help {
        helpText: A single-value select list allows the user to select one option, while the multi-value select list makes it possible to select multiple items. When tagging support is enabled, the user can select from pre-existing options or create new options on the fly.
    }

    entry multiValueSelectList (
        sequence: 20
        display: Multi-value Select List
        return: MULTI
    )

    entry singleValueSelectList (
        sequence: 10
        display: Single-value Select List
        return: SINGLE
    )

    entry taggingSupport (
        sequence: 30
        display: Tagging Support
        return: TAG
    )

)

customAttribute attribute_02 (
    apexlangName: inputTooShortMessage
    attribute: 2
    name: Input Too Short Message
    scope: app
    appearance {
        sequence: 20
    }
    builder {
        translatable: true
    }
    help {
        helpText: The default message is "Please enter x or more characters". It is possible to reference the substitution variables #TERM#, #MINLENGTH# and #REMAININGCHARS#.
    }
)

customAttribute attribute_02 (
    apexlangName: minimumResultsForSearchField
    attribute: 2
    name: Minimum Results for Search Field
    type: integer
    appearance {
        sequence: 20
    }
    builder {
        displayWidth: 8
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: inList
        list: SINGLE
    }
    help {
        helpText: The minimum number of results that must be populated in order to display the search field. A negative value will always hide the search field.
    }
)


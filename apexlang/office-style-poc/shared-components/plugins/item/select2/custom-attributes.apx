    }
)

customAttribute attribute_09 (
    apexlangName: labelForNullOptionGroup
    attribute: 9
    name: Label for Null Option Group
    appearance {
        sequence: 90
    }
    builder {
        translatable: true
        displayWidth: 40
    }
    help {
        helpText: The name of the option group for records whose grouping column value is null. Overwrites the "Label for Null Option Group" attribute in component settings if filled in.
    }
)

customAttribute attribute_10 (
    apexlangName: pathToCustomCssFile
    attribute: 10
    name: Path to Custom CSS File
    scope: app
    validation {
        required: true
    }
    appearance {
        sequence: 6
    }
    dependingOn {
        attribute: @attribute_07/app
        conditionType: inList
        list: CUSTOM
    }
    help {
        helpText: The path to the custom CSS file to style the Select2 items. You are allowed to use substitution strings here.
    }
)

customAttribute attribute_10 (
    apexlangName: width
    attribute: 10
    name: Width
    appearance {
        sequence: 15
    }
    builder {
        displayWidth: 10
    }
    help {
        helpText:
            ```
            Controls the width style attribute of the Select2 item. The following values are supported:
            
            <ul>
              <li><b>element</b> (default): Uses JavaScript to calculate the width of the source element.</li>
              <li><b>off</b>: No width attribute will be set. Keep in mind that the Select2 item copies classes from the source element so setting the width attribute may not always be necessary.</li>
              <li><b>copy</b>: Copies the value of the width style attribute set on the source element.</li>
              <li><b>resolve</b>: First attempts to copy than falls back on element.</li>
              <li><b>other values</b>: Any valid CSS style width value (e.g. 400px or 100%).</li>
            </ul>
            ```
    }
)

customAttribute attribute_11 (
    apexlangName: customCssFilenameNoExtension
    attribute: 11
    name: Custom CSS Filename (no extension)
    scope: app
    validation {
        required: true
    }
    appearance {
        sequence: 7
    }
    dependingOn {
        attribute: @attribute_07/app
        conditionType: inList
        list: CUSTOM
    }
    help {
        helpText: The name of the custom CSS file to style the Select2 items. Do not add the .css extension in this field. You are allowed to use substitution strings here.
    }
)


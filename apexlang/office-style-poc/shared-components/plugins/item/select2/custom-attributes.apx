        helpText: The default message is "The results could not be loaded".
    }
)

customAttribute attribute_08 (
    apexlangName: searchLogic
    attribute: 8
    name: Search Logic
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 80
    }
    default {
        value: CIC
    }
    help {
        helpText: Defines how the search with the entered value should be performed.
    }

    entry containsCaseSensitive (
        sequence: 20
        display: Contains & Case Sensitive
        return: CCS
    )

    entry containsIgnoreCase (
        sequence: 10
        display: Contains & Ignore Case
        return: CIC
    )

    entry containsIgnoreCaseWithDiacritics (
        sequence: 15
        display: Contains & Ignore Case, with Diacritics
        return: CICD
    )

    entry exactCaseSensitive (
        sequence: 40
        display: Exact & Case Sensitive
        return: ECS
    )

    entry exactIgnoreCase (
        sequence: 30
        display: Exact & Ignore Case
        return: EIC
    )

    entry multiWordSearch (
        sequence: 70
        display: Multi-word Search
        return: MW
    )

    entry startsWithCaseSensitive (
        sequence: 60
        display: Starts With & Case Sensitive
        return: SCS
    )

    entry startsWithIgnoreCase (
        sequence: 50
        display: Starts With & Ignore Case
        return: SIC
    )

)


customAttribute attribute_06 (
    apexlangName: rapidSelection
    attribute: 6
    name: Rapid Selection
    type: checkboxes
    appearance {
        sequence: 60
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: inList
        list: [
            MULTI
            TAG
        ]
    }
    help {
        helpText: Prevent the dropdown from closing when an item is selected, allowing for rapid selection of multiple items.
    }

    entry attributeValue (
        sequence: 10
        display: " "
        return: Y
    )

)

customAttribute attribute_07 (
    apexlangName: lookAndFeel
    attribute: 7
    name: Look and Feel
    scope: app
    type: selectList
    validation {
        required: true
    }
    appearance {
        sequence: 5
    }
    default {
        value: SELECT2
    }
    help {
        helpText: Choose how Select2 items should look like.
    }

    entry custom (
        sequence: 30
        display: Custom
        return: CUSTOM
    )

    entry select2 (
        sequence: 10
        display: Select2
        return: SELECT2
    )

    entry select2Classic (
        sequence: 20
        display: Select2 Classic
        return: SELECT2_CLASSIC
    )

)


    apexlangName: dragAndDropSorting
    attribute: 11
    name: Drag and Drop Sorting
    type: checkboxes
    appearance {
        sequence: 65
    }
    dependingOn {
        attribute: @attribute_01/component
        conditionType: inList
        list: [
            MULTI
            TAG
        ]
    }
    help {
        helpText: Allow drag and drop sorting of selected choices.
    }

    entry attributeValue (
        sequence: 10
        display: " "

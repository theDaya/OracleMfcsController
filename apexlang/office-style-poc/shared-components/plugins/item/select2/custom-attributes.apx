    apexlangName: selectOnBlur
    attribute: 7
    name: Select on Blur
    type: checkboxes
    appearance {
        sequence: 70
    }
    help {
        helpText: Determines whether the currently highlighted option is selected when the select list loses focus.
    }

    entry attributeValue (
        sequence: 10
        display: " "
        return: Y
    )

)


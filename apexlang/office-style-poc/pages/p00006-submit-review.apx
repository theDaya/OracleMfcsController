page 6 (
    name: Submit for Review
    alias: SUBMIT-REVIEW
    title: Submit for Review
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region intro (
        name: Review before submitting
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Everything below is what will be sent. Order quantities are still editable here -
                they are the one thing a review is expected to change. Submitting freezes the rest
                and hands the draft to an approver.</p>
                ```
        }
        layout {
            sequence: 5
            slot: contentBody
        }
        appearance {
            template: @alert
            templateOptions: [
                #DEFAULT#
                t-Alert--info
            ]
        }
    )

    region tabs (
        name: What will be sent
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--pill
            ]
        }
    )

    region quantities (
        name: SKUs and Quantities
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select draft_sku_id,
                       composed_sku_no,
                       composed_sku_desc,
                       sku_size,
                       sku_qty
                  from poc_style_draft_sku
                 where draft_id = :P6_DRAFT_ID
                 order by sku_size
                ```
        }
        layout {
            sequence: 30
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @COMPOSED_SKU_NO
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @COMPOSED_SKU_DESC
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @SKU_QTY
                layout {
                    sequence: 3
                }
            )

        )

        column DRAFT_SKU_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: DRAFT_SKU_ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
        )

        column COMPOSED_SKU_NO (
            type: displayOnly
            heading {
                heading: SKU
            }
            layout {
                sequence: 20
            }
            source {
                databaseColumn: COMPOSED_SKU_NO
                dataType: varchar2
                queryOnly: true
            }
        )

        column COMPOSED_SKU_DESC (
            type: displayOnly
            heading {
                heading: Description
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: COMPOSED_SKU_DESC
                dataType: varchar2
                queryOnly: true
            }
        )

        column SKU_SIZE (
            type: displayOnly
            heading {
                heading: Size
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SKU_SIZE
                dataType: varchar2
                queryOnly: true
            }
        )

        column SKU_QTY (
            type: numberField
            heading {
                heading: Quantity
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: SKU_QTY
                dataType: number
            }
        )
    )

    region p6-style (
        name: Style
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.composed_item_no as item,
                       d.composed_item_desc as description,
                       d.operation_name,
                       d.department, d.class, d.subclass,
                       d.supplier, d.origin_country, d.currency_code,
                       d.unit_cost, d.retail_price, d.mfcs_colour
                  from poc_style_draft d
                 where d.draft_id = :P6_DRAFT_ID
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
            ]
        }
        componentAppearance {
            template: @standard
        }

        column ITEM (
            type: plainText
            heading {
                heading: Item number
            }
            layout {
                sequence: 10
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 20
            }
        )

        column OPERATION_NAME (
            type: plainText
            heading {
                heading: Operation
            }
            layout {
                sequence: 30
            }
        )

        column DEPARTMENT (
            type: plainText
            heading {
                heading: Dept
            }
            layout {
                sequence: 40
            }
        )

        column CLASS (
            type: plainText
            heading {
                heading: Class
            }
            layout {
                sequence: 50
            }
        )

        column SUBCLASS (
            type: plainText
            heading {
                heading: Subclass
            }
            layout {
                sequence: 60
            }
        )

        column SUPPLIER (
            type: plainText
            heading {
                heading: Supplier
            }
            layout {
                sequence: 70
            }
        )

        column ORIGIN_COUNTRY (
            type: plainText
            heading {
                heading: Origin
            }
            layout {
                sequence: 80
            }
        )

        column CURRENCY_CODE (
            type: plainText
            heading {
                heading: Currency
            }
            layout {
                sequence: 90
            }
        )

        column UNIT_COST (
            type: plainText
            heading {
                heading: Cost
            }
            layout {
                sequence: 100
            }
        )

        column RETAIL_PRICE (
            type: plainText
            heading {
                heading: Retail
            }
            layout {
                sequence: 110
            }
        )

        column MFCS_COLOUR (
            type: plainText
            heading {
                heading: Colour diff
            }
            layout {
                sequence: 120
            }
        )

    )

    region p6-order (
        name: Order
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select d.order_no, d.source_order_ref, d.delivery_loc, d.import_country,
                       to_char(d.not_before_date, 'YYYY-MM-DD') as not_before,
                       to_char(d.not_after_date, 'YYYY-MM-DD') as not_after,
                       to_char(d.otb_eow_date, 'YYYY-MM-DD') as otb_eow,
                       to_char(d.earliest_ship_date, 'YYYY-MM-DD') as earliest_ship,
                       to_char(d.latest_ship_date, 'YYYY-MM-DD') as latest_ship
                  from poc_style_draft d
                 where d.draft_id = :P6_DRAFT_ID
                   and d.operation_name in ('CREATE_ALL', 'MODIFY_ORDER')
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
            ]
        }
        componentAppearance {
            template: @standard
        }

        column ORDER_NO (
            type: plainText
            heading {
                heading: Order
            }
            layout {
                sequence: 10
            }
        )

        column SOURCE_ORDER_REF (
            type: plainText
            heading {
                heading: Reference
            }
            layout {
                sequence: 20
            }
        )

        column DELIVERY_LOC (
            type: plainText
            heading {
                heading: Delivery
            }
            layout {
                sequence: 30
            }
        )

        column IMPORT_COUNTRY (
            type: plainText
            heading {
                heading: Import
            }
            layout {
                sequence: 40
            }
        )

        column NOT_BEFORE (
            type: plainText
            heading {
                heading: Not before
            }
            layout {
                sequence: 50
            }
        )

        column NOT_AFTER (
            type: plainText
            heading {
                heading: Not after
            }
            layout {
                sequence: 60
            }
        )

        column OTB_EOW (
            type: plainText
            heading {
                heading: OTB week end
            }
            layout {
                sequence: 70
            }
        )

        column EARLIEST_SHIP (
            type: plainText
            heading {
                heading: Earliest ship
            }
            layout {
                sequence: 80
            }
        )

        column LATEST_SHIP (
            type: plainText
            heading {
                heading: Latest ship
            }
            layout {
                sequence: 90
            }
        )

    )

    region p6-udas (
        name: UDAs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.uda_id,
                       (select max(m.description) from master_data m
                         where m.data_type = 'UDA' and m.data_code = u.uda_id) as uda_name,
                       u.uda_value, u.uda_text,
                       to_char(u.uda_date, 'YYYY-MM-DD') as uda_date
                  from poc_draft_uda u
                 where u.draft_id = :P6_DRAFT_ID
                 order by u.uda_id
                ```
        }
        layout {
            sequence: 40
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
            ]
        }
        componentAppearance {
            template: @standard
        }

        column UDA_ID (
            type: plainText
            heading {
                heading: UDA
            }
            layout {
                sequence: 10
            }
        )

        column UDA_NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
        )

        column UDA_VALUE (
            type: plainText
            heading {
                heading: Value
            }
            layout {
                sequence: 30
            }
        )

        column UDA_TEXT (
            type: plainText
            heading {
                heading: Text
            }
            layout {
                sequence: 40
            }
        )

        column UDA_DATE (
            type: plainText
            heading {
                heading: Date
            }
            layout {
                sequence: 50
            }
        )

    )

    region p6-barcodes (
        name: Barcodes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.composed_sku_no as sku, u.upc, u.upc_type, u.primary_yn
                  from poc_draft_sku_upc u
                  join poc_style_draft_sku s on s.draft_sku_id = u.draft_sku_id
                 where s.draft_id = :P6_DRAFT_ID
                 order by s.sku_size, u.primary_yn desc
                ```
        }
        layout {
            sequence: 50
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
            ]
        }
        componentAppearance {
            template: @standard
        }

        column SKU (
            type: plainText
            heading {
                heading: SKU
            }
            layout {
                sequence: 10
            }
        )

        column UPC (
            type: plainText
            heading {
                heading: Barcode
            }
            layout {
                sequence: 20
            }
        )

        column UPC_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
        )

        column PRIMARY_YN (
            type: plainText
            heading {
                heading: Primary
            }
            layout {
                sequence: 40
            }
        )

    )

    region p6-attrs (
        name: Seasons and Tariffs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Season' as kind, to_char(x.season_id) as ref,
                       'phase ' || x.phase_id as detail
                  from poc_draft_season x
                 where x.draft_id = :P6_DRAFT_ID
                union all
                select 'Image', i.image_name, i.image_address
                  from poc_draft_image i
                 where i.draft_id = :P6_DRAFT_ID
                union all
                select 'Tariff', h.hts,
                       'import ' || h.import_country || ', origin ' || h.origin_country
                  from poc_draft_hts h
                 where h.draft_id = :P6_DRAFT_ID
                ```
        }
        layout {
            sequence: 60
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
            ]
        }
        componentAppearance {
            template: @standard
        }

        column KIND (
            type: plainText
            heading {
                heading: Kind
            }
            layout {
                sequence: 10
            }
        )

        column REF (
            type: plainText
            heading {
                heading: Reference
            }
            layout {
                sequence: 20
            }
        )

        column DETAIL (
            type: plainText
            heading {
                heading: Detail
            }
            layout {
                sequence: 30
            }
        )

    )

    pageItem P6_DRAFT_ID (
        type: hidden
        layout {
            sequence: 10
            region: @intro
            slot: regionBody
        }
    )

    pageItem P6_SUBMITTED_BY (
        type: selectList
        label {
            label: Submit to reviewer
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select full_name as d, full_name as r
                  from poc_approver
                 where active_yn = 'Y'
                   and can_approve_yn = 'Y'
                 order by full_name
                ```
        }
        layout {
            sequence: 20
            region: @intro
            slot: regionBody
            alignment: left
            startNewRow: true
            columnSpan: 4
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        help {
            helpText: The person who will approve this draft. Only people who can approve are listed, because submitting to someone who cannot approve stalls the draft.
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @intro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit for Review
        layout {
            sequence: 20
            region: @intro
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process save-quantities (
        name: Save quantities
        type: interactiveGridAutoRowProcessing
        editableRegion: @quantities
        target {
            returnPksAfterInsert: true
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process do-submit (
        name: Submit for review
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_status number;
                    l_response clob;
                begin
                    poc_style_pkg.submit_for_review(
                        :P6_DRAFT_ID, :P6_SUBMITTED_BY, l_status, l_response);

                    if l_status not between 200 and 299 then
                        apex_error.add_error(
                            p_message => 'Not submitted - validation failed: '
                                || dbms_lob.substr(l_response, 800, 1),
                            p_display_location => apex_error.c_inline_in_notification);
                    end if;
                end;
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Submitted for review.
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

)

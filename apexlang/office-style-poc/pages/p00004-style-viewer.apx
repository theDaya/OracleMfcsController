            alignment: left
            startNewRow: true
            columnSpan: 3
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        help {
            helpText: Any MFCS item number. The style is read live through browse_pkg, which uses RmsReSTServices itemDetail to find the children and then reads each one in full.
        }
    )


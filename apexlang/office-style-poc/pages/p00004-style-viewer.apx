page 4 (
    name: Style Viewer
    alias: STYLE-VIEWER
    title: Style Viewer
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: unrestricted
        formAutoComplete: false
    }

    region search (
        name: Read a style from MFCS
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: #DEFAULT#
            icon: fa-search
        }
    )

    region header (
        name: Style
        type: staticContent
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_ITEM_DESC
        }
    )

    region grp-identity (
        name: Identity
        type: staticContent
        layout {
            sequence: 5
            parentRegion: @header
            slot: regionBody
        }
        appearance {
            template: @content-block
            templateOptions: #DEFAULT#
        }
    )

    region grp-hierarchy (
        name: Hierarchy and Differentiators
        type: staticContent
        layout {
            sequence: 6
            parentRegion: @header
            slot: regionBody
        }
        appearance {
            template: @content-block
            templateOptions: #DEFAULT#
        }
    )

    region tabs (
        name: Detail
        type: staticContent
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--pill
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P4_ITEM_DESC
        }
    )

    region skus (
        name: SKUs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.sku, s.sku_desc, s.status, s.diff1, s.diff2,
                       s.original_retail, s.unit_retail
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].resolved.skus[*]'
                           columns
                               sku             varchar2(30)  path '$.item',
                               sku_desc        varchar2(250) path '$.itemDescription',
                               status          varchar2(4)   path '$.status',
                               diff1           varchar2(30)  path '$.diff1',
                               diff2           varchar2(30)  path '$.diff2',
                               original_retail number        path '$.originalRetail',
                               unit_retail     number        path '$.unitRetail'
                       ) s
                 where c.collection_name = 'MFCS_STYLE'
                 order by s.diff2, s.sku
                ```
        }
        layout {
            sequence: 10
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }

        column SKU (
            type: plainText
            heading {
                heading: SKU
            }
            layout {
                sequence: 10
            }
        )

        column SKU_DESC (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 20
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
        )

        column DIFF1 (
            type: plainText
            heading {
                heading: Colour diff
            }
            layout {
                sequence: 40
            }
        )

        column DIFF2 (
            type: plainText
            heading {
                heading: Size diff
            }
            layout {
                sequence: 50
            }
        )

        column ORIGINAL_RETAIL (
            type: plainText
            heading {
                heading: Original retail
            }
            layout {
                sequence: 60
            }
        )

        column UNIT_RETAIL (
            type: plainText
            heading {
                heading: Unit retail
            }
            layout {
                sequence: 70
            }
        )
    )

    region sourcing (
        name: Sourcing
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.supplier, s.primary_supplier_ind, s.direct_ship_ind,
                       s.origin_country, s.unit_cost, s.supplier_pack_size,
                       s.cost_uom, s.purchase_type
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].itemSupplier[*]'
                           columns
                               supplier             number       path '$.supplier',
                               primary_supplier_ind varchar2(1)  path '$.primarySupplierInd',
                               direct_ship_ind      varchar2(1)  path '$.directShipInd',
                               nested path '$.itemSupplierCountry[*]'
                                   columns (
                                       origin_country     varchar2(3)  path '$.originCountry',
                                       unit_cost          number       path '$.unitCost',
                                       supplier_pack_size number       path '$.supplierPackSize',
                                       cost_uom           varchar2(10) path '$.costUom',
                                       purchase_type      varchar2(10) path '$.purchaseType'
                                   )
                       ) s
                 where c.collection_name = 'MFCS_STYLE'
                ```
        }
        layout {
            sequence: 20
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
            ]
        }
        componentAppearance {
            template: @standard
        }

        column SUPPLIER (
            type: plainText
            heading {
                heading: Supplier
            }
            layout {
                sequence: 10
            }
        )

        column PRIMARY_SUPPLIER_IND (
            type: plainText
            heading {
                heading: Primary
            }
            layout {
                sequence: 20
            }
        )

        column DIRECT_SHIP_IND (
            type: plainText
            heading {
                heading: Direct ship
            }
            layout {
                sequence: 30
            }
        )

        column ORIGIN_COUNTRY (
            type: plainText
            heading {
                heading: Origin
            }
            layout {
                sequence: 40
            }
        )

        column UNIT_COST (
            type: plainText
            heading {
                heading: Unit cost
            }
            layout {
                sequence: 50
            }
        )

        column SUPPLIER_PACK_SIZE (
            type: plainText
            heading {
                heading: Pack size
            }
            layout {
                sequence: 60
            }
        )

        column COST_UOM (
            type: plainText
            heading {
                heading: Cost UOM
            }
            layout {
                sequence: 70
            }
        )

        column PURCHASE_TYPE (
            type: plainText
            heading {
                heading: Purchase type
            }
            layout {
                sequence: 80
            }
        )
    )

    region barcodes (
        name: Barcodes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select b.sku, b.barcode, b.primary_ind, b.item_no_type
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].resolved.skus[*]'
                           columns
                               sku varchar2(30) path '$.item',
                               nested path '$.referenceItem[*]'
                                   columns (
                                       barcode      varchar2(30) path '$.referenceItem',
                                       primary_ind  varchar2(1)  path '$.primaryInd',
                                       item_no_type varchar2(10) path '$.itemNoType'
                                   )
                       ) b
                 where c.collection_name = 'MFCS_STYLE'
                   and b.barcode is not null
                 order by b.sku, b.primary_ind desc
                ```
        }
        layout {
            sequence: 30
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
            ]
        }
        componentAppearance {
            template: @standard
        }

        column SKU (
            type: plainText
            heading {
                heading: SKU
            }
            layout {
                sequence: 10
            }
        )

        column BARCODE (
            type: plainText
            heading {
                heading: Barcode
            }
            layout {
                sequence: 20
            }
        )

        column PRIMARY_IND (
            type: plainText
            heading {
                heading: Primary
            }
            layout {
                sequence: 30
            }
        )

        column ITEM_NO_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 40
            }
        )
    )

    region attributes (
        name: Seasons, Images and Tariffs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Season' as kind,
                       to_char(s.season_id) as ref,
                       'phase ' || s.phase_id || ', sequence ' || s.sequence_no as detail
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].itemSeason[*]'
                           columns
                               season_id   number path '$.seasonId',
                               phase_id    number path '$.phaseId',
                               sequence_no number path '$.sequenceNo'
                       ) s
                 where c.collection_name = 'MFCS_STYLE'
                   and s.season_id is not null
                union all
                select 'Image',
                       i.image_name,
                       i.image_address
                           || case when i.primary_image_ind = 'Y' then '  (primary)' else '' end
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].itemImage[*]'
                           columns
                               image_name        varchar2(250) path '$.imageName',
                               image_address     varchar2(250) path '$.imageAddress',
                               primary_image_ind varchar2(1)   path '$.primaryImageInd'
                       ) i
                 where c.collection_name = 'MFCS_STYLE'
                   and i.image_name is not null
                union all
                select 'Tariff code',
                       h.hts,
                       'import ' || h.import_country || ', origin ' || h.origin_country
                           || ', status ' || h.status
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].hts[*]'
                           columns
                               hts            varchar2(30) path '$.hts',
                               import_country varchar2(3)  path '$.importCountry',
                               origin_country varchar2(3)  path '$.originCountry',
                               status         varchar2(10) path '$.status'
                       ) h
                 where c.collection_name = 'MFCS_STYLE'
                   and h.hts is not null
                ```
        }
        layout {
            sequence: 40
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
            ]
        }
        componentAppearance {
            template: @standard
        }

        column KIND (
            type: plainText
            heading {
                heading: Kind
            }
            layout {
                sequence: 10
            }
        )

        column REF (
            type: plainText
            heading {
                heading: Reference
            }
            layout {
                sequence: 20
            }
        )

        column DETAIL (
            type: plainText
            heading {
                heading: Detail
            }
            layout {
                sequence: 30
            }
        )
    )

    region raw (
        name: Raw MFCS Document
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select dbms_lob.substr(c.clob001, 3800, 1) as document,
                       dbms_lob.getlength(c.clob001) as bytes
                  from apex_collections c
                 where c.collection_name = 'MFCS_STYLE'
                ```
        }
        layout {
            sequence: 50
            parentRegion: @tabs
            slot: tabs
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }

        column DOCUMENT (
            type: plainText
            heading {
                heading: First 3800 bytes as returned by MFCS
            }
            layout {
                sequence: 10
            }
        )

        column BYTES (
            type: plainText
            heading {
                heading: Total bytes
            }
            layout {
                sequence: 20
            }
        )
    )

    pageItem P4_ITEM (

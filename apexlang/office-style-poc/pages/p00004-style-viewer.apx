    button read (
        buttonName: READ
        label: Read from MFCS
        layout {
            sequence: 10
            region: @search
            slot: regionBody
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process fetch-style (
        name: Read the style from MFCS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_json clob;
                    l_style_path constant varchar2(30) := '$.items[0]';
                begin
                    if :P4_ITEM is null then
                        return;
                    end if;

                    l_json := browse_pkg.get_style(:P4_ITEM, 'Y');

                    apex_collection.create_or_truncate_collection('MFCS_STYLE');
                    apex_collection.add_member(
                        p_collection_name => 'MFCS_STYLE',
                        p_clob001 => l_json);

                    select json_value(l_json, '$.items[0].item' returning varchar2(30) null on error),
                           json_value(l_json, '$.items[0].itemDescription' returning varchar2(250) null on error),
                           json_value(l_json, '$.items[0].status' returning varchar2(10) null on error),
                           json_value(l_json, '$.items[0].itemNumberType' returning varchar2(10) null on error),
                           json_value(l_json, '$.items[0].itemLevel' returning varchar2(10) null on error),
                           json_value(l_json, '$.items[0].resolved.skuCount' returning varchar2(10) null on error),
                           json_value(l_json, '$.items[0].resolved.source' returning varchar2(60) null on error),
                           json_value(l_json, '$.items[0].dept' returning varchar2(20) null on error)
                               || ' - ' || json_value(l_json, '$.items[0].deptName' returning varchar2(120) null on error),
                           json_value(l_json, '$.items[0].class' returning varchar2(20) null on error)
                               || ' - ' || json_value(l_json, '$.items[0].className' returning varchar2(120) null on error),
                           json_value(l_json, '$.items[0].subclass' returning varchar2(20) null on error)
                               || ' - ' || json_value(l_json, '$.items[0].subclassName' returning varchar2(120) null on error),
                           json_value(l_json, '$.items[0].originalRetail' returning varchar2(30) null on error),
                           json_value(l_json, '$.items[0].diff1' returning varchar2(30) null on error)
                               || ' (' || json_value(l_json, '$.items[0].diff1Type' returning varchar2(4) null on error) || ')',
                           json_value(l_json, '$.items[0].diff2' returning varchar2(30) null on error)
                               || ' (' || json_value(l_json, '$.items[0].diff2Type' returning varchar2(4) null on error) || ')',
                           json_value(l_json, '$.items[0].costZoneGroupId' returning varchar2(30) null on error),
                           json_value(l_json, '$.items[0].standardUom' returning varchar2(10) null on error)
                      into :P4_ITEM_NO, :P4_ITEM_DESC, :P4_STATUS, :P4_NUMBER_TYPE, :P4_ITEM_LEVEL,
                           :P4_SKU_COUNT, :P4_SOURCE, :P4_DEPT, :P4_CLASS, :P4_SUBCLASS,
                           :P4_RETAIL, :P4_DIFF1, :P4_DIFF2, :P4_COST_ZONE, :P4_UOM
                      from dual;

                    if :P4_ITEM_DESC is null then
                        apex_error.add_error(
                            p_message => 'MFCS returned no item for ' || :P4_ITEM
                                || '. A style created moments ago may not be in the '
                                || 'foundation/item cache yet - it lags about a minute.',
                            p_display_location => apex_error.c_inline_in_notification);
                    end if;
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

)

    pageItem P2_OPERATION_NAME (
        type: selectList
        label {
            label: What is being captured
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Style only' as d, 'CREATE_STYLE' as r from dual
                union all select 'Order and Style', 'CREATE_ALL' from dual
                union all select 'Amend an existing order', 'MODIFY_ORDER' from dual
                ```
        }
        layout {
            sequence: 5
            region: @grp-identity
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        default {
            type: static
            staticValue: CREATE_STYLE
        }
        source {
            formRegion: @draft
            column: OPERATION_NAME
            dataType: varchar2
        }
        help {
            helpText: Style only creates the style and its SKUs. Order and Style places an order on top of a style it creates in the same request - the backend sends the whole style write set either way, so an order is never a narrower operation than a style.
        }
    )

    pageItem P2_STYLE_NO (
        type: popupLov
        label {
            label: Style / Model
            alignment: left
        }
        settings {
            displayAs: modalDialog

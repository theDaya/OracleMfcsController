page 2 (
    name: Capture
    alias: CAPTURE
    title: Capture
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region draft (
        name: Style Capture
        type: form
        source {
            location: localDatabase
            tableName: POC_STYLE_DRAFT
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region grp-identity (
        name: 1. Style and Supplier Colour
        type: staticContent
        layout {
            sequence: 5
            parentRegion: @draft
            slot: regionBody
        }
        appearance {
            template: @content-block
            templateOptions: #DEFAULT#
        }
    )

    region grp-merch (
        name: 2. Merchandise and Commercials
        type: staticContent
        layout {
            sequence: 6
            parentRegion: @draft
            slot: regionBody
        }
        appearance {
            template: @content-block
            templateOptions: #DEFAULT#
        }
    )

    region composed (
        name: Composed MFCS Identity
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select attribute, value
                  from (
                select 'Item number' as attribute,
                       nvl(d.composed_item_no, 'not yet composed') as value,
                       10 as seq
                  from poc_style_draft d
                 where d.draft_id = :P2_DRAFT_ID
                union all
                select 'Item description',
                       nvl(d.composed_item_desc, 'not yet composed'),
                       20
                  from poc_style_draft d
                 where d.draft_id = :P2_DRAFT_ID
                union all
                select 'Composed from',
                       m.style_no || ' ' || m.style_desc
                           || '  +  ' || cc.colour_code || ' ' || c.colour_name,
                       30
                  from poc_style_draft d
                  join poc_style_model m on m.style_no = d.style_no
                  join poc_supplier_colour c on c.colour_id = d.colour_id
                  join poc_supplier_colour_code cc on cc.colour_code_id = d.colour_code_id
                 where d.draft_id = :P2_DRAFT_ID
                union all
                select 'MFCS request',
                       nvl(d.action_request_id, 'not submitted')
                           || case when d.http_status is null then ''
                                   else ' - HTTP ' || d.http_status end,
                       40
                  from poc_style_draft d
                 where d.draft_id = :P2_DRAFT_ID
                       )
                 order by seq
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @hero
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @value-attribute-pairs-row
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_DRAFT_ID
        }

        column ATTRIBUTE (
            heading {
                heading: Attribute
            }
            layout {
                sequence: 10
            }
        )

        column VALUE (
            heading {
                heading: Value
            }
            layout {
                sequence: 20
            }
        )

    )

    region sizes (
        name: 3. Size Curve
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select draft_sku_id,
                       draft_id,
                       sku_size,
                       sku_qty
                  from poc_style_draft_sku
                 where draft_id = :P2_DRAFT_ID
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_DRAFT_ID
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @SKU_SIZE
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @SKU_QTY
                layout {
                    sequence: 2
                }
            )

        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 5
            }
        )

        column DRAFT_SKU_ID (
            type: hidden
            layout {
                sequence: 10
            }
            source {
                databaseColumn: DRAFT_SKU_ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
        )

        column DRAFT_ID (
            type: hidden
            layout {
                sequence: 20
            }
            source {
                databaseColumn: DRAFT_ID
                dataType: number
            }
            default {
                type: item
                item: P2_DRAFT_ID
            }
        )

        column SKU_SIZE (
            type: selectList
            heading {
                heading: Size
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select description || ' - ' || data_code as d, data_code as r
                      from master_data
                     where data_type = 'DIFF_S'
                       and data_code <> 'ALL'
                     order by description
                    ```
            }
            layout {
                sequence: 30
            }
            source {
                databaseColumn: SKU_SIZE
                dataType: varchar2
            }
        )

        column SKU_QTY (
            type: numberField
            heading {
                heading: Quantity
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: SKU_QTY
                dataType: number
            }
            default {
                type: static
                staticValue: 1
            }
        )
    )

    region sku-preview (
        name: Composed SKUs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.sku_size,
                       s.sku_qty,
                       s.composed_sku_no,
                       s.composed_sku_desc
                  from poc_style_draft_sku s
                 where s.draft_id = :P2_DRAFT_ID
                   and s.composed_sku_no is not null
                 order by s.sku_size
                ```
        }
        layout {
            sequence: 40

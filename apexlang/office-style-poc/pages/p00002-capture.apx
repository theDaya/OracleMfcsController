        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit for Review
        layout {
            sequence: 60
            region: @draft
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 6
                items: {
                    P6_DRAFT_ID: &P2_DRAFT_ID.
                }
            }
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P2_DRAFT_ID
        }
    )

    process initialize-form-draft (
        name: Initialize form Style Capture
        type: formInitialization
        formRegion: @draft
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form-draft (
        name: Process form Style Capture
        type: formAutoRowProcessing
        formRegion: @draft
        execution {
            sequence: 10
        }
    )

    process save-sizes (
        name: Save Size Curve
        type: interactiveGridAutoRowProcessing
        editableRegion: @sizes
        target {
            returnPksAfterInsert: true
        }
        execution {
            sequence: 20
        }
    )

    process refresh-composition (
        name: Refresh composition
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                    if :P2_DRAFT_ID is not null then
                        poc_style_pkg.refresh_composition(:P2_DRAFT_ID);
                    end if;
                end;
                ```
        }
        execution {
            sequence: 30
        }
    )

    process validate-draft (
        name: Validate draft
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_status number;
                    l_response clob;
                begin
                    poc_style_pkg.validate_draft(:P2_DRAFT_ID, l_status, l_response);
                    apex_error.add_error(
                        p_message => case when l_status between 200 and 299
                                          then 'Validation passed. This document is ready to send.'
                                          else 'Validation failed: '
                                               || dbms_lob.substr(l_response, 900, 1) end,
                        p_display_location => apex_error.c_inline_in_notification);
                end;
                ```
        }
        execution {
            sequence: 40
        }
        serverSideCondition {
            whenButtonPressed: @validate
        }
    )

    process save-udas (
        name: Save UDAs
        type: interactiveGridAutoRowProcessing
        editableRegion: @style-udas
        target {
            returnPksAfterInsert: true
        }
        execution {
            sequence: 21
        }
    )

    process save-barcodes (
        name: Save Barcodes
        type: interactiveGridAutoRowProcessing
        editableRegion: @sku-barcodes
        target {
            returnPksAfterInsert: true
        }
        execution {
            sequence: 22
        }
    )

    process save-seasons (

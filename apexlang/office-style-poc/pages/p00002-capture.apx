    pageItem P2_COLOUR_CODE_ID (
        type: selectList
        label {
            label: Supplier Colour Code
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select colour_code || ' - ' || nvl(code_desc, colour_code) as d,
                       colour_code_id as r
                  from poc_supplier_colour_code
                 where active_yn = 'Y'
                   and colour_id = :P2_COLOUR_ID
                 order by colour_code

        layout {
            sequence: 20
            region: @grp-identity
            slot: regionBody
            alignment: left
            startNewRow: true
            columnSpan: 3
        }
        appearance {
            template: @required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @draft
            column: STYLE_NO
            dataType: varchar2
        }
        help {
            helpText: The tenant's own style list - MFCS UDA 66040, 13,693 values. Its number begins the composed item number and its description begins the composed item description.
        }
    )


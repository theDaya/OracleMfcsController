            }
        )
        column ORIGINAL_RETAIL (
            type: plainText
            heading {
                heading: Original Retail
            }
            layout {
                sequence: 110
            }
        )
        column STANDARD_UOM (
            type: plainText
            heading {
                heading: UOM
            }
            layout {
                sequence: 120
            }
        )
        column COST_ZONE_GROUP_ID (
            type: plainText
            heading {
                heading: Cost Zone
            }
            layout {
                sequence: 130
            }
        )
        column ITEM_NUMBER_TYPE (
            type: plainText
            heading {
                heading: Number Type
            }
            layout {
                sequence: 140
            }
        )
    )

    region detail-tabs (
        name: Detail
        type: staticContent
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--pill
                js-useLocalStorage
            ]
        }
    )

    region skus (
        name: SKUs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.item,
                       j.diff2,
                       j.diff2_description,
                       j.diff1,
                       j.status,
                       j.item_parent,
                       j.item_description
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].resolved.skus[*]'
                           columns
                               item              varchar2(30)  path '$.item',
                               item_description  varchar2(250) path '$.itemDescription',
                               status            varchar2(10)  path '$.status',
                               diff1             varchar2(30)  path '$.diff1',
                               diff2             varchar2(30)  path '$.diff2',
                               diff2_description varchar2(80)  path '$.diff2Description',
                               item_parent       varchar2(30)  path '$.itemParent'
                       ) j
                 where c.collection_name = 'MFCS_BROWSE'
                   and j.item is not null
                 order by j.diff2
                ```
        }
        layout {
            sequence: 10
            parentRegion: @detail-tabs
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }

        column ITEM (
            type: plainText
            heading {
                heading: SKU
            }
            layout {
                sequence: 10
            }
        )
        column DIFF2 (
            type: plainText
            heading {
                heading: Size Diff
            }
            layout {
                sequence: 20
            }
        )
        column DIFF2_DESCRIPTION (
            type: plainText
            heading {
                heading: Size
            }
            layout {
                sequence: 30
            }
        )
        column DIFF1 (
            type: plainText
            heading {
                heading: Colour Diff
            }
            layout {
                sequence: 40
            }
        )
        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 50
            }
        )
        column ITEM_PARENT (
            type: plainText
            heading {
                heading: Parent Style
            }
            layout {
                sequence: 60
            }
        )
        column ITEM_DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 70
            }
        )
    )

    region barcodes (
        name: Barcodes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.sku,
                       j.sku_size,
                       j.reference_item,
                       j.primary_ind,
                       j.item_no_type
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].resolved.skus[*]'
                           columns
                               sku      varchar2(30) path '$.item',
                               sku_size varchar2(80) path '$.diff2Description',
                               nested path '$.referenceItem[*]'
                                   columns (
                                       reference_item varchar2(30) path '$.referenceItem',
                                       primary_ind    varchar2(1)  path '$.primaryInd',
                                       item_no_type   varchar2(10) path '$.itemNoType'
                                   )
                       ) j
                 where c.collection_name = 'MFCS_BROWSE'
                   and j.reference_item is not null
                 order by j.sku, j.primary_ind desc
                ```
        }
        layout {
            sequence: 20
            parentRegion: @detail-tabs
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }

        column SKU (
            type: plainText
            heading {
                heading: SKU
            }
            layout {
                sequence: 10
            }
        )
        column SKU_SIZE (
            type: plainText
            heading {
                heading: Size
            }
            layout {
                sequence: 20
            }
        )
        column REFERENCE_ITEM (
            type: plainText
            heading {
                heading: Barcode
            }
            layout {
                sequence: 30
            }
        )
        column PRIMARY_IND (
            type: plainText
            heading {
                heading: Primary
            }
            layout {
                sequence: 40
            }
        )
        column ITEM_NO_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 50
            }
        )
    )

    region order-lines (
        name: Order Lines
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.item,
                       j.virtual_warehouse,
                       j.physical_location,
                       j.quantity_ordered,
                       j.unit_cost,
                       j.unit_retail,
                       j.origin_country,
                       j.supplier_pack_size,
                       j.earliest_ship_date,
                       j.latest_ship_date
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].details[*]'
                           columns
                               item               varchar2(30) path '$.item',
                               virtual_warehouse  varchar2(20) path '$.virtualWarehouse',
                               physical_location  varchar2(20) path '$.physicalLocation',
                               quantity_ordered   number       path '$.physicalQuantityOrdered',
                               unit_cost          number       path '$.unitCost',
                               unit_retail        number       path '$.unitRetail',
                               origin_country     varchar2(5)  path '$.originCountryId',
                               supplier_pack_size number       path '$.supplierPackSize',
                               earliest_ship_date varchar2(20) path '$.earliestShipDate',
                               latest_ship_date   varchar2(20) path '$.latestShipDate'
                       ) j
                 where c.collection_name = 'MFCS_BROWSE'
                   and j.item is not null
                 order by j.item
                ```
        }
        layout {
            sequence: 30
            parentRegion: @detail-tabs
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }


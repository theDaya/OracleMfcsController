            }
        )
        column UDA_VALUE_DESCRIPTION (
            type: plainText
            heading {
                heading: Means
            }
            layout {
                sequence: 50
            }
        )
    )

    region seasons-tariff (
        name: Seasons and Tariff
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Season' kind,
                       to_char(j.season_id) val_a,
                       to_char(j.phase_id) val_b,
                       to_char(j.sequence_no) val_c,
                       cast(null as varchar2(20)) val_d,
                       cast(null as varchar2(5)) val_e
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].itemSeason[*]'
                           columns
                               season_id   number path '$.seasonId',
                               phase_id    number path '$.phaseId',
                               sequence_no number path '$.sequenceNo'
                       ) j
                 where c.collection_name = 'MFCS_BROWSE'
                   and j.season_id is not null
                union all
                select 'Tariff',
                       j.hts,
                       j.import_country,
                       j.origin_country,
                       j.effect_from,
                       j.status
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].hts[*]'
                           columns
                               hts            varchar2(30) path '$.hts',
                               import_country varchar2(3)  path '$.importCountry',
                               origin_country varchar2(3)  path '$.originCountry',
                               effect_from    varchar2(20) path '$.effectFrom',
                               status         varchar2(5)  path '$.status'
                       ) j
                 where c.collection_name = 'MFCS_BROWSE'
                   and j.hts is not null
                ```
        }
        layout {
            sequence: 70
            parentRegion: @detail-tabs
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }

        column KIND (
            type: plainText
            heading {
                heading: Kind
            }
            layout {
                sequence: 10
            }
        )
        column VAL_A (
            type: plainText
            heading {
                heading: Season / Tariff Code
            }
            layout {
                sequence: 20
            }
        )
        column VAL_B (
            type: plainText
            heading {
                heading: Phase / Import
            }
            layout {
                sequence: 30
            }
        )
        column VAL_C (
            type: plainText
            heading {
                heading: Sequence / Origin
            }
            layout {
                sequence: 40
            }
        )
        column VAL_D (
            type: plainText
            heading {
                heading: Effective From
            }
            layout {
                sequence: 50
            }
        )
        column VAL_E (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 60
            }
        )
    )

    region raw (
        name: Raw Document
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.part_no,
                       dbms_lob.substr(c.clob001, 3800, (p.part_no - 1) * 3800 + 1) part
                  from apex_collections c
                 cross join (select level part_no from dual connect by level <= 40) p
                 where c.collection_name = 'MFCS_BROWSE'
                   and (p.part_no - 1) * 3800 < dbms_lob.getlength(c.clob001)
                 order by p.part_no
                ```
        }
        layout {
            sequence: 80
            parentRegion: @detail-tabs
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }

        column PART_NO (
            type: plainText
            heading {
                heading: Part
            }
            layout {
                sequence: 10
            }
        )
        column PART (
            type: plainText
            heading {
                heading: What MFCS returned
            }
            layout {
                sequence: 20
            }
        )
    )

    pageItem P20_ITEM (
        type: textField
        label {
            label: Style or Order
        }
        layout {
            sequence: 10
            region: @search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        security {
            sessionStateProtection: unrestricted
            encryptSessionState: false
        }
    )

    pageItem P20_KIND (
        type: selectList
        label {
            label: Look up as
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Style' d, 'STYLE' r from dual
                union all
                select 'Purchase Order' d, 'ORDER' r from dual
                ```
            displayNullValue: false
        }
        layout {
            sequence: 20
            region: @search
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: STYLE
        }
        security {
            sessionStateProtection: unrestricted
            encryptSessionState: false
        }
    )

    button fetch (
        buttonName: FETCH
        label: Fetch from MFCS
        layout {
            sequence: 30
            region: @search
            slot: regionBody
            alignment: left
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process fetch-from-mfcs (
        name: Fetch from MFCS
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_doc clob;
                begin
                    if :P20_ITEM is null then
                        return;
                    end if;

                    if :P20_KIND = 'ORDER' then
                        l_doc := browse_pkg.get_order(:P20_ITEM);
                    else
                        l_doc := browse_pkg.get_style(:P20_ITEM, 'Y');
                    end if;

                    apex_collection.create_or_truncate_collection('MFCS_BROWSE');
                    apex_collection.add_member(
                        p_collection_name => 'MFCS_BROWSE',
                        p_clob001         => l_doc);
                end;
                ```
        }
        execution {
            sequence: 10
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: FETCH
        }
    )
)

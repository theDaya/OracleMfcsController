    region attributes (
        name: Attributes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Style' held_on,
                       j.uda_id,
                       j.uda_description,
                       j.uda_value,
                       j.uda_value_description
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].itemUda.udaLov[*]'
                           columns
                               uda_id                number        path '$.udaId',
                               uda_description       varchar2(120) path '$.udaDescription',
                               uda_value             varchar2(30)  path '$.udaValue',
                               uda_value_description varchar2(120) path '$.udaValueDescription'
                       ) j
                 where c.collection_name = 'MFCS_BROWSE'
                   and j.uda_id is not null
                union all
                select 'SKU ' || j.sku,
                       j.uda_id,
                       j.uda_description,
                       j.uda_value,
                       j.uda_value_description
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].resolved.skus[*]'
                           columns
                               sku varchar2(30) path '$.item',
                               nested path '$.itemUda.udaLov[*]'
                                   columns (
                                       uda_id                number        path '$.udaId',
                                       uda_description       varchar2(120) path '$.udaDescription',
                                       uda_value             varchar2(30)  path '$.udaValue',
                                       uda_value_description varchar2(120) path '$.udaValueDescription'
                                   )
                       ) j
                 where c.collection_name = 'MFCS_BROWSE'
                   and j.uda_id is not null
                 order by 1, 2
                ```
        }
        layout {
            sequence: 60
            parentRegion: @detail-tabs
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }

        column HELD_ON (
            type: plainText
            heading {
                heading: Held On
            }
            layout {
                sequence: 10
            }
        )
        column UDA_ID (
            type: plainText
            heading {
                heading: UDA
            }
            layout {
                sequence: 20
            }
        )
        column UDA_DESCRIPTION (
            type: plainText
            heading {
                heading: Attribute
            }
            layout {
                sequence: 30
            }
        )
        column UDA_VALUE (
            type: plainText
            heading {
                heading: Value
            }
            layout {

page 20 (
    name: Style Explorer
    title: Style Explorer
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region search (
        name: Look up in MFCS
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
    )

    region order-head (
        name: Order
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.order_no,
                       j.status,
                       j.order_type,
                       j.supplier,
                       j.dept || '  ' || j.dept_name department,
                       j.currency_code,
                       j.terms_code,
                       j.freight_terms,
                       j.not_before_date,
                       j.not_after_date,
                       j.otb_eow_date,
                       j.earliest_ship_date,
                       j.latest_ship_date,
                       j.written_date,
                       j.import_country_id,
                       j.comments
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0]'
                           columns
                               order_no           varchar2(30)  path '$.orderNo',
                               status             varchar2(10)  path '$.status',
                               order_type         varchar2(20)  path '$.orderType',
                               supplier           varchar2(30)  path '$.supplier',
                               dept               varchar2(20)  path '$.dept',
                               dept_name          varchar2(60)  path '$.deptName',
                               currency_code      varchar2(5)   path '$.currencyCode',
                               terms_code         varchar2(20)  path '$.termsCode',
                               freight_terms      varchar2(20)  path '$.freightTerms',
                               not_before_date    varchar2(20)  path '$.notBeforeDate',
                               not_after_date     varchar2(20)  path '$.notAfterDate',
                               otb_eow_date       varchar2(20)  path '$.otbEowDate',
                               earliest_ship_date varchar2(20)  path '$.earliestShipDate',
                               latest_ship_date   varchar2(20)  path '$.latestShipDate',
                               written_date       varchar2(20)  path '$.writtenDate',
                               import_country_id  varchar2(5)   path '$.importCountryId',
                               comments           varchar2(250) path '$.comments'
                       ) j
                 where c.collection_name = 'MFCS_BROWSE'
                   and j.order_no is not null
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @standard
        }

        column ORDER_NO (
            type: plainText
            heading {
                heading: Order
            }
            layout {
                sequence: 10
            }
        )
        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 20
            }
        )
        column ORDER_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 30
            }
        )
        column SUPPLIER (
            type: plainText
            heading {
                heading: Supplier
            }
            layout {
                sequence: 40
            }
        )
        column DEPARTMENT (
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 50
            }
        )
        column CURRENCY_CODE (
            type: plainText
            heading {
                heading: Currency
            }
            layout {
                sequence: 60
            }
        )
        column TERMS_CODE (
            type: plainText
            heading {
                heading: Terms
            }
            layout {
                sequence: 70
            }
        )
        column FREIGHT_TERMS (
            type: plainText
            heading {
                heading: Freight
            }
            layout {
                sequence: 80
            }
        )
        column NOT_BEFORE_DATE (
            type: plainText
            heading {
                heading: Not Before
            }
            layout {
                sequence: 90
            }
        )
        column NOT_AFTER_DATE (
            type: plainText
            heading {
                heading: Not After
            }
            layout {
                sequence: 100
            }
        )
        column OTB_EOW_DATE (
            type: plainText
            heading {
                heading: OTB EOW
            }
            layout {
                sequence: 110
            }
        )
        column EARLIEST_SHIP_DATE (
            type: plainText
            heading {
                heading: Earliest Ship
            }
            layout {
                sequence: 120
            }
        )
        column LATEST_SHIP_DATE (
            type: plainText
            heading {
                heading: Latest Ship
            }
            layout {
                sequence: 130
            }
        )
        column WRITTEN_DATE (
            type: plainText
            heading {
                heading: Written
            }
            layout {
                sequence: 140
            }
        )
        column IMPORT_COUNTRY_ID (
            type: plainText
            heading {
                heading: Import Country
            }
            layout {
                sequence: 150
            }
        )
        column COMMENTS (
            type: plainText
            heading {
                heading: Comments
            }
            layout {
                sequence: 160
            }
        )
    )

    region style-head (
        name: Style
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.item,
                       j.item_description,
                       j.status,
                       j.dept || '  ' || j.dept_name department,
                       j.class || '  ' || j.class_name class_,
                       j.subclass || '  ' || j.subclass_name subclass_,
                       j.division_name || '  /  ' || j.group_name division_group,
                       j.diff1 || '  ' || j.diff1_type colour_diff,
                       j.diff2 || '  ' || j.diff2_type size_diff,
                       j.unit_retail,
                       j.original_retail,
                       j.standard_uom,
                       j.cost_zone_group_id,
                       j.item_number_type
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0]'
                           columns
                               item                varchar2(30)  path '$.item',
                               item_description    varchar2(250) path '$.itemDescription',
                               status              varchar2(10)  path '$.status',
                               dept                varchar2(20)  path '$.dept',
                               dept_name           varchar2(60)  path '$.deptName',
                               class               varchar2(20)  path '$.class',
                               class_name          varchar2(60)  path '$.className',
                               subclass            varchar2(20)  path '$.subclass',
                               subclass_name       varchar2(60)  path '$.subclassName',
                               division_name       varchar2(60)  path '$.divisionName',
                               group_name          varchar2(60)  path '$.groupName',
                               diff1               varchar2(30)  path '$.diff1',
                               diff1_type          varchar2(10)  path '$.diff1Type',
                               diff2               varchar2(30)  path '$.diff2',
                               diff2_type          varchar2(10)  path '$.diff2Type',
                               unit_retail         number        path '$.unitRetail',
                               original_retail     number        path '$.originalRetail',
                               standard_uom        varchar2(10)  path '$.standardUom',
                               cost_zone_group_id  number        path '$.costZoneGroupId',
                               item_number_type    varchar2(10)  path '$.itemNumberType'
                       ) j
                 where c.collection_name = 'MFCS_BROWSE'
                   and j.item is not null
                ```
        }
        layout {
            sequence: 30
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            template: @standard
        }

        column ITEM (
            type: plainText
            heading {
                heading: Style
            }
            layout {
                sequence: 10
            }
        )
        column ITEM_DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 20
            }
        )
        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
        )
        column DEPARTMENT (
            type: plainText
            heading {
                heading: Department
            }
            layout {
                sequence: 40
            }
        )
        column CLASS_ (
            type: plainText
            heading {
                heading: Class
            }
            layout {
                sequence: 50
            }
        )
        column SUBCLASS_ (
            type: plainText
            heading {
                heading: Subclass
            }
            layout {
                sequence: 60
            }
        )
        column DIVISION_GROUP (
            type: plainText
            heading {
                heading: Division / Group
            }
            layout {
                sequence: 70
            }
        )
        column COLOUR_DIFF (
            type: plainText
            heading {
                heading: diff1 Colour
            }
            layout {

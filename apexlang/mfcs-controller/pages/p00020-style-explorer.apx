    region linked-orders (
        name: Linked Orders
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.order_no,
                       r.style_no,
                       r.operation_name,
                       r.request_status,
                       r.action_request_id,
                       to_char(r.created_at, 'YYYY-MM-DD HH24:MI') created_at
                  from request r
                 where r.order_no is not null
                   and (   r.style_no = :P20_ITEM
                        or r.order_no = :P20_ITEM
                        or exists (select 1
                                     from entity_map e
                                    where e.source_system = r.source_system
                                      and e.source_style_ref = r.source_style_ref
                                      and e.mfcs_sku_no = :P20_ITEM))
                 order by r.created_at desc
                ```
        }
        layout {
            sequence: 40
            parentRegion: @detail-tabs
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }

        column ORDER_NO (
            type: plainText
            heading {
                heading: Order
            }
            layout {
                sequence: 10
            }
        )
        column STYLE_NO (
            type: plainText
            heading {
                heading: Style
            }
            layout {
                sequence: 20
            }
        )
        column OPERATION_NAME (
            type: plainText
            heading {
                heading: Operation
            }
            layout {
                sequence: 30
            }
        )
        column REQUEST_STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 40
            }
        )
        column CREATED_AT (
            type: plainText
            heading {
                heading: Created
            }
            layout {
                sequence: 50
            }
        )
        column ACTION_REQUEST_ID (
            type: plainText
            heading {
                heading: Request
            }
            layout {
                sequence: 60
            }
        )
    )

    region sourcing (
        name: Sourcing
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.supplier,
                       j.primary_supplier,
                       j.origin_country,
                       j.primary_country,
                       j.unit_cost,
                       j.cost_uom,
                       j.supplier_pack_size,
                       j.inner_pack_size
                  from apex_collections c,
                       json_table(c.clob001, '$.items[0].itemSupplier[*]'
                           columns
                               supplier         varchar2(30) path '$.supplier',
                               primary_supplier varchar2(1)  path '$.primarySupplierInd',
                               nested path '$.itemSupplierCountry[*]'
                                   columns (
                                       origin_country     varchar2(3)  path '$.originCountry',
                                       primary_country    varchar2(1)  path '$.primaryCountryInd',
                                       unit_cost          number       path '$.unitCost',
                                       supplier_pack_size number       path '$.supplierPackSize',
                                       inner_pack_size    number       path '$.innerPackSize',
                                       cost_uom           varchar2(10) path '$.costUom'
                                   )
                       ) j
                 where c.collection_name = 'MFCS_BROWSE'
                   and j.supplier is not null
                ```
        }
        layout {
            sequence: 50
            parentRegion: @detail-tabs
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }

        column SUPPLIER (
            type: plainText
            heading {
                heading: Supplier
            }
            layout {
                sequence: 10
            }
        )
        column PRIMARY_SUPPLIER (
            type: plainText
            heading {
                heading: Primary
            }
            layout {
                sequence: 20
            }
        )
        column ORIGIN_COUNTRY (
            type: plainText
            heading {
                heading: Origin
            }
            layout {
                sequence: 30
            }
        )
        column PRIMARY_COUNTRY (
            type: plainText
            heading {
                heading: Primary Country
            }
            layout {
                sequence: 40
            }
        )
        column UNIT_COST (
            type: plainText
            heading {
                heading: Unit Cost
            }
            layout {
                sequence: 50
            }
        )
        column COST_UOM (
            type: plainText
            heading {
                heading: Cost UOM
            }
            layout {
                sequence: 60
            }
        )
        column SUPPLIER_PACK_SIZE (
            type: plainText
            heading {
                heading: Supplier Pack
            }
            layout {
                sequence: 70
            }
        )
        column INNER_PACK_SIZE (
            type: plainText
            heading {
                heading: Inner Pack
            }
            layout {

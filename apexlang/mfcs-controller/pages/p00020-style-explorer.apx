            }
        )
        column QUANTITY_ORDERED (
            type: plainText
            heading {
                heading: Qty
            }
            layout {
                sequence: 20
            }
        )
        column UNIT_COST (
            type: plainText
            heading {
                heading: Unit Cost
            }
            layout {
                sequence: 30
            }
        )
        column UNIT_RETAIL (
            type: plainText
            heading {
                heading: Unit Retail
            }
            layout {
                sequence: 40
            }
        )
        column VIRTUAL_WAREHOUSE (
            type: plainText
            heading {
                heading: Virtual WH
            }
            layout {
                sequence: 50
            }
        )
        column PHYSICAL_LOCATION (
            type: plainText
            heading {
                heading: Physical
            }
            layout {
                sequence: 60
            }
        )
        column ORIGIN_COUNTRY (
            type: plainText
            heading {
                heading: Origin
            }
            layout {

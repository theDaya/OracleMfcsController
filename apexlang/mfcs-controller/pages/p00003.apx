            dataType: number
        }
    )

    pageItem P3_CLASS (
        type: selectList
        label {
            label: Class
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select data_code || ' - ' || description d, data_code r
                  from master_data
                 where data_type = 'CLASS'
                   and parent_code = :P3_DEPARTMENT
                 order by to_number(nullif(regexp_replace(data_code, '[^0-9]', ''), '')), data_code
                ```
        }
        cascadingLov {
            parentItems: P3_DEPARTMENT
            itemsToSubmit: P3_DEPARTMENT
        }
        layout {
            sequence: 120
            region: @draft
            slot: regionBody
            alignment: left
            startNewRow: false

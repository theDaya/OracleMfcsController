        column DRAFT_SKU_ID (
            type: selectList
            heading {
                heading: SKU
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Size ' || s.sku_size d,
                           s.draft_sku_id r
                    -- Only the SKUs on this draft. A barcode belongs to one SKU,
                    -- and the size is how a buyer recognises it.
                      from ui_draft_sku s
                     where s.draft_id = :P3_DRAFT_ID
                     order by s.draft_sku_id
                    ```
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: DRAFT_SKU_ID
                dataType: number
            }
        )

        column UPC (
            type: textField
            heading {
                heading: Barcode
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: UPC
                dataType: varchar2
            }
        )

        column UPC_TYPE (
            type: selectList
            heading {
                heading: Type
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'EAN13' d, 'EAN13' r from dual
                    union all
                    -- A real Office SKU carries one EAN13 and one MANL.
                    select 'MANL' d, 'MANL' r from dual
                    ```
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: UPC_TYPE
                dataType: varchar2
            }
            default {
                type: static
                staticValue: EAN13
            }
        )

        column PRIMARY_YN (
            type: selectList
            heading {
                heading: Primary
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Yes' d, 'Y' r from dual
                    union all
                    select 'No' d, 'N' r from dual
                    ```
                displayNullValue: false
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: PRIMARY_YN
                dataType: varchar2
            }
            default {
                type: static
                staticValue: Y
            }
        )
    )


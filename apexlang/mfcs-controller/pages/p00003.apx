        column SKU_SIZE (
            type: selectList
            heading {
                heading: SKU Size
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select substr(config_key, length('MAP.SIZE.') + 1)
                           || ' - ' || dbms_lob.substr(config_value, 200, 1),
                           substr(config_key, length('MAP.SIZE.') + 1)
                      from config
                     where environment = 'DEFAULT'
                       and enabled_ind = 'Y'
                       and config_key like 'MAP.SIZE.%'
                     order by 1
                    ```
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: SKU_SIZE
                dataType: varchar2
            }

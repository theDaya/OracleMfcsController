    pageItem P3_DEPARTMENT (
        type: selectList
        label {
            label: Department
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select data_code || ' - ' || description d, data_code r
                  from master_data
                 where data_type = 'DEPARTMENT'
                 order by to_number(nullif(regexp_replace(data_code, '[^0-9]', ''), '')), data_code
                ```
        }
        layout {
            sequence: 110
            region: @draft
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#

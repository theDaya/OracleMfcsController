        column DRAFT_UDA_ID (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: DRAFT_UDA_ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column UDA_ID (
            type: selectList
            heading {
                heading: Attribute
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select md.description || ' (' || md.data_code || ')' d,
                           to_number(md.data_code) r
                      from master_data md
                     where md.data_type = 'UDA'
                       and md.parent_code = '~'
                     order by md.description
                    ```
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: UDA_ID
                dataType: number
            }
        )

        column UDA_VALUE (
            type: selectList
            heading {
                heading: Value
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select v.description d, v.data_code r
                    -- Narrowed to the attribute chosen in this row. Cascading on a
                    -- grid column binds the parent column like a page item.
                      from master_data v
                     where v.data_type = 'UDA_VALUE'
                       and v.parent_code = to_char(:UDA_ID)
                     order by v.description
                    ```
            }
            cascadingLov {
                parentColumns: UDA_ID
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: UDA_VALUE
                dataType: varchar2
            }
        )

        column UDA_TEXT (
            type: textField
            heading {
                heading: Free Text
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: UDA_TEXT
                dataType: varchar2
            }
        )

        column UDA_DATE (
            type: datePicker
            heading {
                heading: Date
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: UDA_DATE
                dataType: date
            }
        )
    )


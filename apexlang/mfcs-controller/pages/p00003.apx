    button validate (
        buttonName: VALIDATE
        label: Validate
        layout {
            sequence: 60
            region: @draft
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DRAFT_ID
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit
        layout {
            sequence: 70
            region: @draft
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DRAFT_ID
        }
    )

    process initialize-form-draft (
        name: Initialize form Draft
        type: formInitialization
        formRegion: @draft
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form-draft (
        name: Process form Draft
        type: formAutoRowProcessing
        formRegion: @draft
        execution {
            sequence: 10
        }
    )

    process save-skus (
        name: Save SKUS
        type: interactiveGridAutoRowProcessing
        editableRegion: @skus
        target {
            returnPksAfterInsert: true
        }
        execution {
            sequence: 20
        }
    )

    process save-style-udas (
        name: Save Style Attributes
        type: interactiveGridAutoRowProcessing
        editableRegion: @style-udas
        target {
            returnPksAfterInsert: true
        }
        execution {
            sequence: 21
        }
    )

    process save-sku-barcodes (
        name: Save Barcodes
        type: interactiveGridAutoRowProcessing
        editableRegion: @sku-barcodes
        target {
            returnPksAfterInsert: true
        }
        execution {
            sequence: 22
        }
    )

    process save-style-seasons (
        name: Save Seasons
        type: interactiveGridAutoRowProcessing
        editableRegion: @style-seasons
        target {
            returnPksAfterInsert: true
        }
        execution {
            sequence: 23
        }
    )

    process save-style-images (
        name: Save Images
        type: interactiveGridAutoRowProcessing
        editableRegion: @style-images
        target {
            returnPksAfterInsert: true
        }
        execution {
            sequence: 24
        }
    )

    process save-style-hts (
        name: Save Tariff Codes
        type: interactiveGridAutoRowProcessing
        editableRegion: @style-hts
        target {
            returnPksAfterInsert: true
        }
        execution {
            sequence: 25
        }
    )

    process preview-draft (
        name: Preview draft
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_status number;
                    l_response clob;
                begin
                    ui_pkg.preview_draft(:P3_DRAFT_ID, l_status, l_response);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Payload preview refreshed.
        }
        serverSideCondition {
            whenButtonPressed: @preview
        }
    )

    process validate-draft (
        name: Validate draft
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_status number;
                    l_response clob;
                begin
                    ui_pkg.validate_draft(:P3_DRAFT_ID, l_status, l_response);
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: MFCS validation completed.
        }
        serverSideCondition {
            whenButtonPressed: @validate
        }
    )

    process submit-draft (
        name: Submit draft
        type: executeCode
        source {
            plsqlCode: ui_pkg.enqueue_submit(:P3_DRAFT_ID);
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Draft submitted to the MFCS integration pipeline.
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Back to Browse after delete
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 5
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

page 3 (
    name: Create / Edit
    title: Create / Edit
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            (function () {
                if (apex.item("P3_DRAFT_ID").getValue()) {
                    return;
                }
            
                function pad(n) {
                    return String(n).padStart(2, "0");
                }
            
                function ymd(date) {
                    return date.getFullYear() + "-" + pad(date.getMonth() + 1) + "-" + pad(date.getDate());
                }
            
                function addDays(base, days) {
                    var date = new Date(base);
                    date.setDate(date.getDate() + days);
                    return date;
                }
            
                function setIfBlank(itemName, value) {
                    var item = apex.item(itemName);
                    if (!item.getValue()) {
                        item.setValue(value, null, true);
                    }
                }
            
                var today = new Date();
                today.setHours(0, 0, 0, 0);
            
                var nowStamp = new Date().toISOString().replace("T", " ").substring(0, 19);
                var daysUntilSunday = (7 - today.getDay()) % 7 || 7;
            
                setIfBlank("P3_DESCRIPTION", "apexTest " + nowStamp);
                setIfBlank("P3_SOURCE_STYLE_REF", "apexStyle " + nowStamp);
                setIfBlank("P3_SOURCE_ORDER_REF", "apexOrder " + nowStamp);
                setIfBlank("P3_NOT_BEFORE_DATE", ymd(addDays(today, 1)));
                setIfBlank("P3_NOT_AFTER_DATE", ymd(addDays(today, 7)));
                setIfBlank("P3_OTB_EOW_DATE", ymd(addDays(today, daysUntilSunday)));
                setIfBlank("P3_EARLIEST_SHIP_DATE", ymd(addDays(today, 1)));
                setIfBlank("P3_LATEST_SHIP_DATE", ymd(addDays(today, 7)));
            })();
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region draft (
        name: MFCS Draft
        type: form
        source {
            location: localDatabase
            tableName: UI_DRAFT
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    region associated-items (
        name: Associated Items
        type: regionDisplaySelector
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            regionDisplaySelector: true
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DRAFT_ID
        }
        settings {
            includeShowAll: false
            rememberSelection: bySession
        }
    )

    region skus (
        name: SKUS
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select draft_sku_id,
                       draft_id,
                       source_variant_ref,
                       sku_size,
                       sku_width,
                       sku_qty,
                       sku_id
                  from ui_draft_sku
                 where draft_id = :P3_DRAFT_ID
                ```
        }
        layout {
            sequence: 30
            parentRegion: @associated-items
            slot: subRegions
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--removeHeader
                t-Region--scrollBody
            ]
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 320
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (

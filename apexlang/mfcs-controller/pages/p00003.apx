            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        componentAppearance {
            showNullValuesAs: -
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        heading {
            fixedTo: region
            fixedReportHeight: 320
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )

            displayColumn (
                column: @HTS
                layout {
                    sequence: 1
                }
            )

            displayColumn (
                column: @IMPORT_COUNTRY
                layout {
                    sequence: 2
                }
            )

            displayColumn (
                column: @ORIGIN_COUNTRY
                layout {
                    sequence: 3
                }
            )

            displayColumn (
                column: @EFFECT_FROM
                layout {
                    sequence: 4
                }
            )

            displayColumn (
                column: @EFFECT_TO
                layout {
                    sequence: 5
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 20
            }
        )

        column DRAFT_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: DRAFT_ID
                dataType: number
            }
            default {
                type: item
                item: P3_DRAFT_ID
            }
        )

        column DRAFT_HTS_ID (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: DRAFT_HTS_ID
                dataType: number
                queryOnly: true
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column HTS (
            type: textField
            heading {
                heading: Tariff Code
            }
            layout {
                sequence: 50
            }
            source {
                databaseColumn: HTS
                dataType: varchar2
            }
        )

        column IMPORT_COUNTRY (
            type: selectList
            heading {
                heading: Import Country
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select data_code || ' - ' || description d, data_code r
                      from master_data
                     where data_type = 'COUNTRY'
                     order by description
                    ```
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IMPORT_COUNTRY
                dataType: varchar2
            }
        )

        column ORIGIN_COUNTRY (
            type: selectList
            heading {
                heading: Origin Country
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select data_code || ' - ' || description d, data_code r
                      from master_data
                     where data_type = 'COUNTRY'
                     order by description
                    ```
            }
            layout {
                sequence: 70
            }
            source {
                databaseColumn: ORIGIN_COUNTRY
                dataType: varchar2
            }
        )

        column EFFECT_FROM (
            type: datePicker
            heading {
                heading: Effective From
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: EFFECT_FROM
                dataType: date
            }
        )

        column EFFECT_TO (
            type: datePicker
            heading {
                heading: Effective To
            }
            layout {
                sequence: 90
            }
            source {
                databaseColumn: EFFECT_TO
                dataType: date
            }
        )
    )

    region preview (
        name: Payload Preview
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select request_payload,
                       preview_payload,
                       response_payload
                  from ui_draft
                 where draft_id = :P3_DRAFT_ID
                ```
        }
        layout {
            sequence: 40
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        componentAppearance {
            template: @standard
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DRAFT_ID
        }

        column PREVIEW_PAYLOAD (
            type: plainText
            heading {
                heading: Preview Payload
            }
            layout {
                sequence: 20
            }
        )

        column REQUEST_PAYLOAD (
            type: plainText
            heading {
                heading: Request Payload
            }
            layout {
                sequence: 10
            }
        )

        column RESPONSE_PAYLOAD (
            type: plainText
            heading {
                heading: Response Payload
            }
            layout {
                sequence: 30
            }
        )

    )


    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @draft
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @draft
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectUrl
            targetUrl: javascript:apex.confirm(htmldb_delete_message,'DELETE');
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DRAFT_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @draft
            slot: change
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DRAFT_ID
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @draft
            slot: create
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_DRAFT_ID
        }
    )

    button preview (
        buttonName: PREVIEW
        label: Preview
        layout {
            sequence: 50
            region: @draft
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DRAFT_ID
        }
    )

    button validate (
        buttonName: VALIDATE
        label: Validate
        layout {
            sequence: 60
            region: @draft
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DRAFT_ID
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit
        layout {
            sequence: 70
            region: @draft
            slot: edit
        }
        appearance {
            buttonTemplate: @text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_DRAFT_ID
        }
    )

    process initialize-form-draft (
        name: Initialize form Draft
        type: formInitialization
        formRegion: @draft
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form-draft (
        name: Process form Draft
        type: formAutoRowProcessing
        formRegion: @draft
        execution {
            sequence: 10
        }
    )

    process save-skus (
        name: Save SKUS
        type: interactiveGridAutoRowProcessing
        editableRegion: @skus
        target {
            returnPksAfterInsert: false
        }
        execution {
            sequence: 20
        }
    )

    process preview-draft (
        name: Preview draft
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_status number;
                    l_response clob;
                begin
                    ui_pkg.preview_draft(:P3_DRAFT_ID, l_status, l_response);
                end;
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Payload preview refreshed.
        }
        serverSideCondition {
            whenButtonPressed: @preview
        }
    )

    process validate-draft (
        name: Validate draft
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                    l_status number;
                    l_response clob;
                begin
                    ui_pkg.validate_draft(:P3_DRAFT_ID, l_status, l_response);
                end;
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: MFCS validation completed.
        }
        serverSideCondition {
            whenButtonPressed: @validate
        }
    )

    process submit-draft (
        name: Submit draft
        type: executeCode
        source {
            plsqlCode: ui_pkg.enqueue_submit(:P3_DRAFT_ID);
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Draft submitted to the MFCS integration pipeline.
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    branch (
        name: Back to Browse after delete
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 5
            }
        }
        serverSideCondition {
            whenButtonPressed: @delete
        }
    )

)

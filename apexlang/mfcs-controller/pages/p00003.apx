    pageItem P3_DEPARTMENT (
        type: selectList
        label {
            label: Department
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select dept_code || ' - ' || nvl(md.description, mapped_dept), dept_code
                  from (
                        select substr(config_key, length('MAP.DEPARTMENT.') + 1) dept_code,
                               dbms_lob.substr(config_value, 200, 1) mapped_dept
                          from config
                         where environment = 'DEFAULT'
                           and enabled_ind = 'Y'
                           and config_key like 'MAP.DEPARTMENT.%'
                       ) c
                  left join master_data md
                    on md.data_type = 'DEPARTMENT'
                   and md.data_code = c.mapped_dept
                 order by to_number(nullif(regexp_replace(dept_code, '[^0-9]', ''), '')), dept_code
                ```
        }
        layout {
            sequence: 110
            region: @draft
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @draft
            column: DEPARTMENT
            dataType: number
        }
    )

    pageItem P3_CLASS (
        type: selectList
        label {
            label: Class
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select class_code || ' - ' || nvl(md.description, mapped_class), class_code
                  from (
                        select regexp_substr(config_key, '[^.]+', 1, 4) class_code,
                               dbms_lob.substr(config_value, 200, 1) mapped_class
                          from config
                         where environment = 'DEFAULT'
                           and enabled_ind = 'Y'
                           and config_key like 'MAP.CLASS.' || :P3_DEPARTMENT || '.%'
                       ) c
                  left join master_data md
                    on md.data_type = 'CLASS'
                   and md.parent_code = to_char(:P3_DEPARTMENT)
                   and md.data_code = c.mapped_class
                 order by class_code
                ```
        }
        cascadingLov {
            parentItems: P3_DEPARTMENT
            itemsToSubmit: P3_DEPARTMENT
        }
        layout {
            sequence: 120
            region: @draft
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @draft
            column: CLASS
            dataType: number
        }
    )

    pageItem P3_SUBCLASS (
        type: selectList
        label {
            label: Subclass
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select subclass_code || ' - ' || nvl(md.description, mapped_subclass), subclass_code
                  from (
                        select regexp_substr(config_key, '[^.]+', 1, 5) subclass_code,
                               dbms_lob.substr(config_value, 200, 1) mapped_subclass
                          from config
                         where environment = 'DEFAULT'
                           and enabled_ind = 'Y'
                           and config_key like 'MAP.SUBCLASS.' || :P3_DEPARTMENT || '.' || :P3_CLASS || '.%'
                       ) c
                  left join master_data md
                    on md.data_type = 'SUBCLASS'
                   and md.parent_code = to_char(:P3_DEPARTMENT) || '.' || to_char(:P3_CLASS)
                   and md.data_code = c.mapped_subclass
                 order by subclass_code
                ```
        }
        cascadingLov {
            parentItems: [
                P3_DEPARTMENT
                P3_CLASS
            ]
            itemsToSubmit: [
                P3_DEPARTMENT
                P3_CLASS
            ]
        }
        layout {
            sequence: 130
            region: @draft
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @required-above
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @draft
            column: SUBCLASS
            dataType: number
        }
    )

    pageItem P3_SUPPLIER (
        type: selectList
        label {
            label: Supplier
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select supplier_code || ' - ' || nvl(md.description, mapped_supplier), supplier_code
                  from (
                        select substr(config_key, length('MAP.SUPPLIER.') + 1) supplier_code,
                               dbms_lob.substr(config_value, 200, 1) mapped_supplier
                          from config
                         where environment = 'DEFAULT'
                           and enabled_ind = 'Y'
                           and config_key like 'MAP.SUPPLIER.%'
                       ) c
                  left join master_data md
                    on md.data_type = 'SUPPLIER'
                   and md.data_code = c.mapped_supplier
                 where md.data_code is not null
                 order by supplier_code
                ```
        }
        layout {
            sequence: 140
            region: @draft
            slot: regionBody
            alignment: left
            startNewRow: false

        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select location_code || ' - virtual ' || mapped_location, location_code
                  from (
                        select substr(config_key, length('MAP.ORDER_LOCATION.') + 1) location_code,
                               dbms_lob.substr(config_value, 200, 1) mapped_location
                          from config
                         where environment = 'DEFAULT'
                           and enabled_ind = 'Y'
                           and config_key like 'MAP.ORDER_LOCATION.%'
                       )
                 order by location_code
                ```
        }
        layout {
            sequence: 210
            region: @draft
            slot: regionBody
            alignment: left
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @draft
            column: DELIVERY_LOC
            dataType: number
        }
    )


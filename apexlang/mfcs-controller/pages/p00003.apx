    pageItem P3_SUBCLASS (
        type: selectList
        label {
            label: Subclass
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select data_code || ' - ' || description d, data_code r
                  from master_data
                 where data_type = 'SUBCLASS'
                   and parent_code = :P3_DEPARTMENT || '.' || :P3_CLASS
                 order by to_number(nullif(regexp_replace(data_code, '[^0-9]', ''), '')), data_code
                ```
        }
        cascadingLov {
            parentItems: [
                P3_DEPARTMENT
                P3_CLASS
            ]
            itemsToSubmit: [
                P3_DEPARTMENT
                P3_CLASS
            ]
        }
        layout {
            sequence: 130

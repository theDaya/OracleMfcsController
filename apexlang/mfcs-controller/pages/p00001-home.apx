page 1 (
    name: Home
    alias: HOME
    title: MFCS Controller
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        formAutoComplete: false
    }

    region mfcs-controller (
        name: MFCS Controller
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @hero
            templateOptions: #DEFAULT#
            icon: fa-cloud-plus
        }
    )

)
